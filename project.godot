; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited manually.

[application]

config/name="YunYuLingGui"
config/description="云屿灵归 - A healing sokoban puzzle game"
run/main_scene="res://Scenes/main.tscn"
config/features=PackedStringArray("4.2", "Vulkan Clustered")

[autoload]

GameManager="*res://Scripts/Autoloads/game_manager.gd"
LevelManager="*res://Scripts/Autoloads/level_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

